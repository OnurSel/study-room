# Copy to .env for local docker compose (never commit .env). Replace every placeholder.
POSTGRES_DB=studyroom
POSTGRES_USER=studyroom
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# ---- Variables the backend actually reads (set these on the host, e.g. Render) ----
# JDBC URL, e.g. jdbc:postgresql://localhost:5432/studyroom  (Neon: add ?sslmode=require)
DATABASE_URL=jdbc:postgresql://localhost:5432/studyroom
DATABASE_USERNAME=studyroom
DATABASE_PASSWORD=CHANGE_ME_LOCAL_ONLY
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# true for TLS Redis providers (e.g. Upstash); leave unset for plain Redis
SPRING_DATA_REDIS_SSL_ENABLED=
# Random secret, at least 32 UTF-8 bytes (e.g. `openssl rand -hex 32`)
STUDYROOM_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# Public https origin of the deployed app (WebSocket origin check), comma-separated
STUDYROOM_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
